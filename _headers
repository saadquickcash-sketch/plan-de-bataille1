# Pages HTML : toujours revalider auprès du serveur (jamais de version figée en cache)
/*
  Cache-Control: no-cache, must-revalidate

# Ressources versionnées via ?v=NN : cache long (une nouvelle version = nouvelle URL)
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Le service worker et le manifeste doivent toujours rester frais
/sw.js
  Cache-Control: no-cache, must-revalidate
/manifest.json
  Cache-Control: no-cache, must-revalidate
